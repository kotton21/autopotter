# Autopotter Environment Variables
# Copy this file to .env and fill in your actual values
# cp .env.example .env

# ============================================
# Instagram/Facebook API Configuration
# ============================================
# Get these from: https://developers.facebook.com/apps/
FB_APP_ID=your_app_id # needed for token refresh
FB_APP_SECRET=your_app_secret # needed for token refresh
INSTAGRAM_USER_ID=your_instagram_user_id
INSTAGRAM_ACCESS_TOKEN=your_long_lived_access_token

# ============================================
# OpenAI API Configuration
# ============================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# ============================================
# JSON2Video API Configuration
# ============================================
# Get your API key from: https://json2video.com/
JSON2VIDEO_API_KEY=your_json2video_api_key

# ============================================
# Google Cloud Storage Configuration
# ============================================
# Path to your GCS service account JSON credentials file
# Download from: https://console.cloud.google.com/iam-admin/serviceaccounts
GCS_API_KEY_PATH=/path/to/your/gcs-credentials.json
